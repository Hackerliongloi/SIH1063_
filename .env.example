ENVIRONMENT=development
API_PROXY_TARGET=http://localhost:8000
DATABASE_URL=postgresql+psycopg://polar:polar-local-password@postgres:5432/polar
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
MAX_UPLOAD_MB=200

# ── Admin credentials (role: admin) ──────────────────────────────────────────
# Single admin account. Has full access: publish, approve, manage users, etc.
ADMIN_EMAIL=admin@polar.local
ADMIN_PASSWORD=ChangeMe-Admin-Only-123!

# ── Regular user credentials (role: public_user) ──────────────────────────────
# Standard viewer account. Can browse public content only.
# NOTE: Must be a different email from ADMIN_EMAIL and SUBMITTER_EMAIL.
USER_EMAIL=user@polar.local
USER_PASSWORD=ChangeMe-User-Only-123!

# ── Submitter credentials (role: submitter) ───────────────────────────────────
# Approved submitter. Can upload/submit assets for editorial review.
# NOTE: Must be a different email from ADMIN_EMAIL and USER_EMAIL.
SUBMITTER_EMAIL=submitter@polar.local
SUBMITTER_PASSWORD=ChangeMe-Submitter-Only-123!

# ── LLM / OpenRouter ──────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
MODEL_NAME=openrouter/free
MODEL_API_KEY=replace-with-your-openrouter-api-key
MODEL_BASE_URL=http://ollama:11434
MODEL_PATH=

# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@polar.local

# ── Social / Webhook ──────────────────────────────────────────────────────────
# Set SOCIAL_WEBHOOK_ENABLED=true and provide the HTTPS webhook URL and a
# high-entropy shared secret in production. PUBLIC_APP_URL must be publicly
# reachable so the automation platform can fetch attached media.
SOCIAL_WEBHOOK_ENABLED=false
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_SECRET=

# ── Cloudinary (optional; falls back to S3/local when unset) ──────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
STORAGE_BUCKET=polar-assets
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=polar
STORAGE_SECRET_KEY=polar-local-secret
