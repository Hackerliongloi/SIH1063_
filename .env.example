ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://polar:polar-local-password@postgres:5432/polar
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_APP_URL
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000
API_PROXY_TARGET=http://localhost:8000
MAX_UPLOAD_MB=200
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=polar
STORAGE_SECRET_KEY=polar-local-secret
STORAGE_BUCKET=polar-assets
LLM_PROVIDER=openrouter
MODEL_NAME=openrouter/free
# For Ollama: MODEL_BASE_URL=http://ollama:11434 (when on the Compose network)
# For OpenRouter free routing: LLM_PROVIDER=openrouter, MODEL_NAME=openrouter/free,
# MODEL_API_KEY=<your OpenRouter key>
MODEL_API_KEY=replace-with-your-openrouter-api-key
MODEL_BASE_URL=http://ollama:11434
MODEL_PATH=
ADMIN_EMAIL=admin@polar.local
ADMIN_PASSWORD=ChangeMe-Local-Only-123!

SOCIAL_WEBHOOK_ENABLED=false
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@polar.local

# Set SOCIAL_WEBHOOK_ENABLED=true and provide the HTTPS webhook URL and a
# high-entropy shared secret in production. PUBLIC_APP_URL must be publicly
# reachable so the automation platform can fetch attached media.

# Cloudinary media storage (optional; falls back to S3/local when unset)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
